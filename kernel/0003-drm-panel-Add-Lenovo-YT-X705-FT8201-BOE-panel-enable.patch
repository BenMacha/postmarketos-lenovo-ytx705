From 50595d594e99b1fb8ac3f636a2adb200392db8c8 Mon Sep 17 00:00:00 2001
From: benmecha <dali@benmacha.tn>
Date: Mon, 26 Oct 2026 22:18:13 +0000
Subject: [PATCH 3/5] drm/panel: Add Lenovo YT-X705 FT8201 BOE panel; enable
 display and GPU

Panel driver generated with linux-mdss-dsi-panel-driver-generator from the
stock device tree. The panel is mounted upside down (rotation 180), so the
touchscreen is no longer inverted: the compositor rotates both.
---
 .../boot/dts/qcom/sdm439-lenovo-ytx705.dts    |  71 ++++-
 .../gpu/drm/panel/msm89x7-generated/Kconfig   |   4 +
 .../gpu/drm/panel/msm89x7-generated/Makefile  |   1 +
 .../panel-lenovo-ytx705-ft8201-boe.c          | 260 ++++++++++++++++++
 4 files changed, 335 insertions(+), 1 deletion(-)
 create mode 100644 drivers/gpu/drm/panel/msm89x7-generated/panel-lenovo-ytx705-ft8201-boe.c

diff --git a/arch/arm64/boot/dts/qcom/sdm439-lenovo-ytx705.dts b/arch/arm64/boot/dts/qcom/sdm439-lenovo-ytx705.dts
index 38eb00015..a26643815 100644
--- a/arch/arm64/boot/dts/qcom/sdm439-lenovo-ytx705.dts
+++ b/arch/arm64/boot/dts/qcom/sdm439-lenovo-ytx705.dts
@@ -78,6 +78,25 @@ ramoops@bffc0000 {
 		};
 	};
 
+	/* Panel power and backlight enable, already on from the bootloader */
+	lcd_pwr: lcd-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_pwr";
+		gpio = <&tlmm 17 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	lcd_bl_en: lcd-bl-en-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_bl_en";
+		gpio = <&pm8953_gpios 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
 	vph_pwr: vph-pwr-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "vph_pwr";
@@ -112,12 +131,62 @@ touchscreen@38 {
 
 		touchscreen-size-x = <1200>;
 		touchscreen-size-y = <1920>;
-		/* The panel is mounted upside down (stock: panel-orientation 180) */
+		/*
+		 * The panel is mounted upside down; the bootloader framebuffer is
+		 * not rotated, so the touch axes are inverted to match it.
+		 */
 		touchscreen-inverted-x;
 		touchscreen-inverted-y;
 	};
 };
 
+/*
+ * The DSI path is described but kept off: the 12nm DSI PLL does not lock
+ * yet, and a failed msm-mdss probe also kills the bootloader framebuffer.
+ * Until then the display runs on simple-framebuffer.
+ */
+&gpu {
+	status = "disabled";
+};
+
+&mdss {
+	status = "disabled";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8953_l23>;
+	vddio-supply = <&pm8953_l6>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "lenovo,ytx705-ft8201-boe";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
+		/* Mounted upside down, like the stock qcom,mdss-dsi-panel-orientation */
+		rotation = <180>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vddio-supply = <&pm8953_l6>;
+	qcom,dsi-phy-regulator-ldo-mode;
+
+	status = "okay";
+};
+
 &pm8953_resin {
 	linux,code = <KEY_VOLUMEDOWN>;
 
diff --git a/drivers/gpu/drm/panel/msm89x7-generated/Kconfig b/drivers/gpu/drm/panel/msm89x7-generated/Kconfig
index 810998b7b..48cab3f68 100644
--- a/drivers/gpu/drm/panel/msm89x7-generated/Kconfig
+++ b/drivers/gpu/drm/panel/msm89x7-generated/Kconfig
@@ -162,3 +162,7 @@ config DRM_PANEL_XIAOMI_UGGLITE_OTM1901A_TM
 	default DRM_PANEL_MSM89X7_GENERATED
 
 endmenu
+
+config DRM_PANEL_LENOVO_YTX705_FT8201_BOE
+	tristate "Lenovo YT-X705 FT8201 BOE"
+	default DRM_PANEL_MSM89X7_GENERATED
diff --git a/drivers/gpu/drm/panel/msm89x7-generated/Makefile b/drivers/gpu/drm/panel/msm89x7-generated/Makefile
index 8072c8f07..8d01ccfba 100644
--- a/drivers/gpu/drm/panel/msm89x7-generated/Makefile
+++ b/drivers/gpu/drm/panel/msm89x7-generated/Makefile
@@ -37,3 +37,4 @@ obj-$(CONFIG_DRM_PANEL_XIAOMI_SANTONI_ILI9881C_EBBG) += panel-xiaomi-santoni-ili
 obj-$(CONFIG_DRM_PANEL_XIAOMI_UGGLITE_ILI9881C_SC) += panel-xiaomi-ugglite-ili9881c-sc.o
 obj-$(CONFIG_DRM_PANEL_XIAOMI_UGGLITE_OTM1901A_HX) += panel-xiaomi-ugglite-otm1901a-hx.o
 obj-$(CONFIG_DRM_PANEL_XIAOMI_UGGLITE_OTM1901A_TM) += panel-xiaomi-ugglite-otm1901a-tm.o
+obj-$(CONFIG_DRM_PANEL_LENOVO_YTX705_FT8201_BOE) += panel-lenovo-ytx705-ft8201-boe.o
diff --git a/drivers/gpu/drm/panel/msm89x7-generated/panel-lenovo-ytx705-ft8201-boe.c b/drivers/gpu/drm/panel/msm89x7-generated/panel-lenovo-ytx705-ft8201-boe.c
new file mode 100644
index 000000000..b79c574d0
--- /dev/null
+++ b/drivers/gpu/drm/panel/msm89x7-generated/panel-lenovo-ytx705-ft8201-boe.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 Ben Macha
+// Generated with linux-mdss-dsi-panel-driver-generator from vendor device tree:
+//   Copyright (c) 2013, The Linux Foundation. All rights reserved.
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/mod_devicetable.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct lenovo_ytx705_ft8201_boe {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline
+struct lenovo_ytx705_ft8201_boe *to_lenovo_ytx705_ft8201_boe(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct lenovo_ytx705_ft8201_boe, panel);
+}
+
+static void lenovo_ytx705_ft8201_boe_reset(struct lenovo_ytx705_ft8201_boe *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(35);
+}
+
+static int lenovo_ytx705_ft8201_boe_on(struct lenovo_ytx705_ft8201_boe *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x11, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x50, 0x5a, 0x19);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xa0, 0x00, 0x00, 0x66);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x50, 0x5a, 0x23);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x90, 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x94, 0x24, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x29, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 10000, 11000);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x50, 0x00);
+
+	return dsi_ctx.accum_err;
+}
+
+static int lenovo_ytx705_ft8201_boe_off(struct lenovo_ytx705_ft8201_boe *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x28, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x10, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x04, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x05, 0x5a);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int lenovo_ytx705_ft8201_boe_prepare(struct drm_panel *panel)
+{
+	struct lenovo_ytx705_ft8201_boe *ctx = to_lenovo_ytx705_ft8201_boe(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	lenovo_ytx705_ft8201_boe_reset(ctx);
+
+	ret = lenovo_ytx705_ft8201_boe_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int lenovo_ytx705_ft8201_boe_unprepare(struct drm_panel *panel)
+{
+	struct lenovo_ytx705_ft8201_boe *ctx = to_lenovo_ytx705_ft8201_boe(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = lenovo_ytx705_ft8201_boe_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	return 0;
+}
+
+static const struct drm_display_mode lenovo_ytx705_ft8201_boe_mode = {
+	.clock = (1200 + 48 + 8 + 45) * (1920 + 155 + 8 + 32) * 60 / 1000,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 48,
+	.hsync_end = 1200 + 48 + 8,
+	.htotal = 1200 + 48 + 8 + 45,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 155,
+	.vsync_end = 1920 + 155 + 8,
+	.vtotal = 1920 + 155 + 8 + 32,
+	.width_mm = 135,
+	.height_mm = 217,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int lenovo_ytx705_ft8201_boe_get_modes(struct drm_panel *panel,
+				      struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &lenovo_ytx705_ft8201_boe_mode);
+}
+
+static const struct drm_panel_funcs lenovo_ytx705_ft8201_boe_panel_funcs = {
+	.prepare = lenovo_ytx705_ft8201_boe_prepare,
+	.unprepare = lenovo_ytx705_ft8201_boe_unprepare,
+	.get_modes = lenovo_ytx705_ft8201_boe_get_modes,
+};
+
+static int lenovo_ytx705_ft8201_boe_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
+// correct values. If not, remove this function.
+static int lenovo_ytx705_ft8201_boe_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops lenovo_ytx705_ft8201_boe_bl_ops = {
+	.update_status = lenovo_ytx705_ft8201_boe_bl_update_status,
+	.get_brightness = lenovo_ytx705_ft8201_boe_bl_get_brightness,
+};
+
+static struct backlight_device *
+lenovo_ytx705_ft8201_boe_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 4095,
+		.max_brightness = 4095,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &lenovo_ytx705_ft8201_boe_bl_ops, &props);
+}
+
+static int lenovo_ytx705_ft8201_boe_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct lenovo_ytx705_ft8201_boe *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct lenovo_ytx705_ft8201_boe, panel,
+				   &lenovo_ytx705_ft8201_boe_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS |
+			  MIPI_DSI_MODE_VIDEO_NO_HSA | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = lenovo_ytx705_ft8201_boe_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void lenovo_ytx705_ft8201_boe_remove(struct mipi_dsi_device *dsi)
+{
+	struct lenovo_ytx705_ft8201_boe *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id lenovo_ytx705_ft8201_boe_of_match[] = {
+	{ .compatible = "lenovo,ytx705-ft8201-boe" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lenovo_ytx705_ft8201_boe_of_match);
+
+static struct mipi_dsi_driver lenovo_ytx705_ft8201_boe_driver = {
+	.probe = lenovo_ytx705_ft8201_boe_probe,
+	.remove = lenovo_ytx705_ft8201_boe_remove,
+	.driver = {
+		.name = "panel-lenovo-ytx705-ft8201-boe",
+		.of_match_table = lenovo_ytx705_ft8201_boe_of_match,
+	},
+};
+module_mipi_dsi_driver(lenovo_ytx705_ft8201_boe_driver);
+
+MODULE_AUTHOR("Ben Macha");
+MODULE_DESCRIPTION("DRM driver for boe ft8201 1200p video mode dsi panel");
+MODULE_LICENSE("GPL");
